# Copy to `keystore.properties` (gitignored) and fill in. Read by app/build.gradle.kts to sign the
# release bundle.
#
# storeFile is resolved relative to src/app/, so an absolute path is the safest choice — the
# keystore must live outside the repo. This is the *upload* key: with Play App Signing enabled,
# Google holds the actual app signing key, so losing this one is recoverable by contacting Play
# support. Back it up anyway.

storeFile=C:/Users/you/keys/nfc-spool-writer-upload.jks
storePassword=
keyAlias=upload
keyPassword=
